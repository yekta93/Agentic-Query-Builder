# LLM Provider (OpenRouter recommended)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Langfuse for observability / tracing of LangGraph nodes
# Create a project at https://cloud.langfuse.com (or use self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Override default model
# DEFAULT_MODEL=google/gemma-2-27b-it
